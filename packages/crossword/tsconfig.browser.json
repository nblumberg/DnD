{
  "extends": "../../tsconfig.browser.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "../minigames/dist",
    "rootDir": "../minigames/src",

    "tsBuildInfoFile": "../minigames/node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // "noEmit": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "../minigames/src/board/**/*",
    "../minigames/src/browser/**/*",
    "../minigames/src/browser/**/*.scss",
    "../minigames/src/shared/**/*",
    "../minigames/src/crossword-service/crossWords.ts",
    "../minigames/src/crossword-service/wordBank.ts"
  ]
}
