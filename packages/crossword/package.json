{
  "name": "crossword-service",
  "version": "1.0.0",
  "description": "Manage crosswords",
  "type": "module",
  "main": "./dist/js/index.js",
  "exports": {
    ".": "./dist/js/index.js",
    "./client": "./dist/js/client/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "build:watch": "vite build --watch",
    "build": "npm run clean && tsc --build --force --verbose && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-tsc": "yarn clean && tsc --build --force --verbose",
    "tsc-watch": "yarn clean && tsc --build --force --verbose --watch",
    "test": "jest",
    "testWatch": "jest --watch",
    "start": "node --input-type=module dist/js/index.js",
    "serve": "yarn build && yarn start"
  },
  "author": "nathanielblumberg@gmail.com",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint/js": "^9.17.0",
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "@socket.io/admin-ui": "^0.5.1",
    "compendium-service": "workspace:*",
    "cors": "^2.8.5",
    "creature": "*",
    "event-emitter": "*",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.4",
    "state-change": "*"
  }
}
