{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "target": "es5"
  },
  "files": ["src/js/index.ts"],
  "include": ["src/js/**/*"]
}
